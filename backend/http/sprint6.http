@baseUrl = http://localhost:8080/api
@ownerEmail = owner@gymduongdouble.local
@ownerPassword = ChangeMe@2026
@year = 2026
@month = 9

### Owner login
# @name loginOwner
POST {{baseUrl}}/v1/auth/login
Content-Type: application/json

{
  "email": "{{ownerEmail}}",
  "password": "{{ownerPassword}}"
}

###
@ownerToken = {{loginOwner.response.body.$.data.accessToken}}

### Owner dashboard
GET {{baseUrl}}/v1/dashboard/owner?year={{year}}&month={{month}}
Authorization: Bearer {{ownerToken}}

### Create revenue goal
# @name createRevenueGoal
POST {{baseUrl}}/v1/business-goals
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "year": {{year}},
  "month": {{month}},
  "category": "FINANCE",
  "metricName": "REVENUE",
  "targetValue": 100000000,
  "unit": "VND",
  "note": "Má»¥c tiÃªu doanh thu thÃ¡ng"
}

### Create manual PT goal
# @name createManualPtGoal
POST {{baseUrl}}/v1/business-goals
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "year": {{year}},
  "month": {{month}},
  "category": "NEW_PT_CUSTOMER",
  "metricName": "PT_CUSTOMER_COUNT",
  "targetValue": 4,
  "actualValueOverride": 2,
  "unit": "khÃ¡ch",
  "note": "VÃ­ dá»¥ actual nháº­p tay tá»« báº£ng má»¥c tiÃªu"
}

### List goals
GET {{baseUrl}}/v1/business-goals?year={{year}}&month={{month}}
Authorization: Bearer {{ownerToken}}

### Goal progress
GET {{baseUrl}}/v1/business-goals/progress?year={{year}}&month={{month}}
Authorization: Bearer {{ownerToken}}

### Finance report monthly
GET {{baseUrl}}/v1/reports/finance?year={{year}}&month={{month}}
Authorization: Bearer {{ownerToken}}

### Finance report yearly
GET {{baseUrl}}/v1/reports/finance?year={{year}}
Authorization: Bearer {{ownerToken}}

### Member report
GET {{baseUrl}}/v1/reports/members?year={{year}}&month={{month}}
Authorization: Bearer {{ownerToken}}

### Notifications
GET {{baseUrl}}/v1/notifications
Authorization: Bearer {{ownerToken}}


