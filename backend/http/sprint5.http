@baseUrl = http://localhost:8080/api
@ownerEmail = owner@gymduongdouble.local
@ownerPassword = ChangeMe@2026

### Health
GET {{baseUrl}}/v1/health

### Public - list exercise categories without login
GET {{baseUrl}}/v1/public/exercise-categories

### Public - list published TikTok exercises without login
GET {{baseUrl}}/v1/public/exercises?size=20

### Owner login
# @name loginOwner
POST {{baseUrl}}/v1/auth/login
Content-Type: application/json

{
  "email": "{{ownerEmail}}",
  "password": "{{ownerPassword}}"
}

###
@ownerToken = {{loginOwner.response.body.$.data.accessToken}}

### Owner - create category
# @name createExerciseCategory
POST {{baseUrl}}/v1/owner/exercise-categories
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "name": "Sprint 5 Test",
  "slug": "sprint-5-test",
  "description": "Danh má»¥c kiá»ƒm thá»­ Sprint 5",
  "iconName": "Dumbbell",
  "sortOrder": 90,
  "active": true
}

###
@categoryId = {{createExerciseCategory.response.body.$.data.id}}

### Owner - create TikTok exercise
# @name createExercise
POST {{baseUrl}}/v1/owner/exercises
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "categoryId": {{categoryId}},
  "title": "Sprint 5 TikTok Squat Test",
  "description": "Video kiá»ƒm thá»­ thÆ° viá»‡n TikTok cÃ´ng khai.",
  "instruction": "Giá»¯ lÆ°ng trung láº­p, Ä‘áº§u gá»‘i Ä‘i theo hÆ°á»›ng mÅ©i chÃ¢n.",
