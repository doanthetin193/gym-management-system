  "published": true
}

###
@exerciseId = {{createExercise.response.body.$.data.id}}
@exerciseSlug = {{createExercise.response.body.$.data.slug}}

### Public - find exercise by keyword
GET {{baseUrl}}/v1/public/exercises?keyword=Squat&size=20

### Public - detail by slug
GET {{baseUrl}}/v1/public/exercises/{{exerciseSlug}}

### Public - increment view count
POST {{baseUrl}}/v1/public/exercises/{{exerciseId}}/view

### Owner - hide exercise
PATCH {{baseUrl}}/v1/owner/exercises/{{exerciseId}}/published
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "published": false
}

### Public - hidden exercise should not be found
GET {{baseUrl}}/v1/public/exercises/{{exerciseSlug}}

### Owner - list hidden exercise
GET {{baseUrl}}/v1/owner/exercises?published=false&keyword=Squat&size=20
Authorization: Bearer {{ownerToken}}


